# Environment variables for Shift Sense
# Copy this file to .env and fill in your actual values

# Google Gemini API Key (optional - for AI reasoning layer)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Specify Gemini model to use
# Set this only when you need to override the code default.
GEMINI_MODEL=gemini-3.6-flash